{
  "schema_version": "4.0",
  "v49_exact_discrete_requirements": {
    "active_training_doi_coverage": 1.0,
    "active_calibration_doi_coverage": 1.0,
    "active_test_doi_coverage": 1.0,
    "train_calibration_source_doi_overlap_count": 0,
    "train_test_source_doi_overlap_count": 0,
    "calibration_test_source_doi_overlap_count": 0,
    "excluded_train_source_overlap_row_count": "locked_by_canonical_reference",
    "activation_cv_splitter": "StratifiedGroupKFold",
    "activation_cv_random_state": 45,
